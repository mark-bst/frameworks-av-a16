cc_defaults {
    name: "widevine_service_defaults",
    vendor: true,

    srcs: [
        "CryptoFactory.cpp",
        "CryptoPlugin.cpp",
        "DrmFactory.cpp",
        "DrmPlugin.cpp",
        "TypeConvert.cpp",
        "WVUUID.cpp",
        "BoringSslCompat.cpp",
    ],

    relative_install_path: "hw",

    compile_multilib: "32",

    cflags: ["-Wall", "-Werror", "-Wthread-safety"],

    shared_libs: [
        "android.hardware.drm@1.0",
        "android.hardware.drm@1.1",
        "android.hardware.drm@1.2",
        "android.hardware.drm@1.3",
        "libbase",
        "libbinder",
        "libcutils",
        "libcrypto",
        "libhidlbase",
        "libhidlmemory",
        "libwvdrmengine",
        "liblog",
        "libstagefright_foundation",
        "libutils",
    ],

    local_include_dirs: [
        "include",
    ],

    include_dirs: [
        "frameworks/native/include",
        "frameworks/av/include",
    ],
}

cc_binary {
    name: "android.hardware.drm@1.3-service.widevine",
    defaults: ["widevine_service_defaults"],
    srcs: ["service.cpp"],
    init_rc: ["android.hardware.drm@1.3-service.widevine.rc"],
    vintf_fragments: ["manifest_android.hardware.drm@1.3-service.widevine.xml"],
}
